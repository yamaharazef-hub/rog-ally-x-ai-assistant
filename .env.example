# Copy to .env and keep it private:  cp .env.example .env && chmod 600 .env
# The main app needs no pip packages. A key is only needed for AI replies.

# --- Brain ---------------------------------------------------------------
AI_PROVIDER=arena
ARENA_API_KEY=
ARENA_BASE_URL=https://api.arena.ai/v1
ARENA_MODEL=coding-router-preview
# Get a key: https://platform.arena.ai/dashboard/keys
# If your key is restricted to Claude Code, use a workspace with API access
# or set ARENA_MODEL to a model enabled for your key.
ARENA_AGENT_URL=https://arena.ai/agent

# Alternative OpenAI-compatible endpoint:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Alternative fully local brain:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# --- Local server --------------------------------------------------------
HOST=127.0.0.1
PORT=8787
PERMISSION_MODE=guarded
ASSISTANT_DRY_RUN=0
# Override the browser opener if xdg-open picks the wrong app:
# BROWSER_COMMAND=flatpak run org.mozilla.firefox

# --- Voice ---------------------------------------------------------------
SPEECH_LANG=en-US
# Browser speech works in Chromium/Edge. Local Whisper needs:
# ./scripts/install_whisper.sh
WHISPER_PYTHON=python3
WHISPER_MODEL=small.en
WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=5
